{
  "inputs": [
    {
      "type": "promptString",
      "id": "sooveryn-key",
      "description": "Sooveryn API key",
      "password": true
    }
  ],
  "servers": {
    "sooveryn": {
      "type": "http",
      "url": "https://mcp.sooveryn.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:sooveryn-key}"
      }
    }
  }
}
